rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────

    function isAuth()        { return request.auth != null; }
    function isOwner(uid)    { return isAuth() && request.auth.uid == uid; }

    // Is the current user a registered coach?
    function isCoach() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
    }

    // Is the current user the linked coach for a given player UID?
    // Relies on users/{playerUid}.coachUid written by linkingService.js on login.
    function isLinkedCoach(playerUid) {
      return isCoach() &&
        get(/databases/$(database)/documents/users/$(playerUid)).data.get('coachUid', '') == request.auth.uid;
    }

    // ── App configuration (coach access code etc.) ────────────────────────────
    match /appConfig/{doc} {
      // Anyone can read config (to verify coach code on registration)
      allow read: if isAuth();
      // Only the platform coach/admin can write config
      allow write: if isCoach();
    }

    // ── User profiles ──────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      allow read: if isLinkedCoach(uid);
      // Allow a coach to clear coachUid when removing a player from roster
      allow update: if isCoach() &&
        get(/databases/$(database)/documents/users/$(uid)).data.get('coachUid','') == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coachUid']);
    }

    // ── Player evaluations ─────────────────────────────────────────────────────
    match /evaluations/{playerUid}/sessions/{sessionId} {
      // Only the player writes their own evaluations
      allow write: if isOwner(playerUid);
      // Player OR linked coach can read
      allow read: if isOwner(playerUid) || isLinkedCoach(playerUid);
    }

    // ── Coach-assigned training ────────────────────────────────────────────────
    match /coachTraining/{playerUid}/sessions/{sessionId} {
      // Only the linked coach writes training for a player
      allow write: if isLinkedCoach(playerUid);
      // Player OR linked coach can read
      allow read: if isOwner(playerUid) || isLinkedCoach(playerUid);
    }

    // ── Coach feedback ─────────────────────────────────────────────────────────
    match /coachFeedback/{playerUid}/messages/{msgId} {
      allow write: if isLinkedCoach(playerUid);
      allow read: if isOwner(playerUid) || isLinkedCoach(playerUid);
    }

    // ── Player ↔ Coach chat ────────────────────────────────────────────────────
    match /chats/{playerUid}/messages/{msgId} {
      // Both the player and their linked coach can read and write
      allow read, write: if isOwner(playerUid) || isLinkedCoach(playerUid);
    }

    // ── Coach rosters ──────────────────────────────────────────────────────────
    match /playerRosters/{coachUid}/players/{playerId} {
      // Coach manages their full roster
      allow read, write: if isOwner(coachUid);
      // Player can update ONLY their own entry when accepting an invite (sets uid, name, invited, linkedAt)
      allow update: if isAuth() &&
        resource.data.email == request.auth.token.email &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['uid', 'name', 'invited', 'linkedAt']);
    }

    // ── Player→Coach lookup (for push notifications) ───────────────────────────
    match /playerCoach/{sanitizedEmail} {
      // Any authenticated user can read (push token lookup)
      allow read: if isAuth();
      // Only a registered coach can write this mapping
      allow write: if isCoach();
    }

    // ── Coach invite requests ──────────────────────────────────────────────────
    match /linkRequests/{requestId} {
      allow create: if isCoach();
      // Coach reads their own requests; player reads invites addressed to them
      allow read: if isAuth() && (
        resource.data.coachUid == request.auth.uid ||
        resource.data.playerEmail == request.auth.token.email
      );
      // Player can accept — match by stored playerUid OR email token (belt+braces)
      allow update: if isAuth() && (
        resource.data.get('playerUid','') == request.auth.uid ||
        resource.data.playerEmail == request.auth.token.email
      );
      allow delete: if isAuth() && resource.data.coachUid == request.auth.uid;
    }

    // ── Player personal data ───────────────────────────────────────────────────
    match /schedules/{uid}/events/{eventId} {
      allow read, write: if isOwner(uid);
    }

    match /matchReports/{uid}/reports/{reportId} {
      allow read, write: if isOwner(uid);
    }

    match /speedDrills/{uid}/results/{resultId} {
      allow read, write: if isOwner(uid);
    }

    // ── Workout ratings (player thumb up/down on workouts) ─────────────────────
    match /workoutRatings/{uid}/ratings/{ratingId} {
      allow read, write: if isOwner(uid);
    }
  }
}
